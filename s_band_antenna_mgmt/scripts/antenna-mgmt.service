[Unit]
Description=S-Band Antenna Management Service
Documentation=file:///opt/vendor/docs/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

# 工作目录指向当前版本
WorkingDirectory=/opt/vendor/current

# 升级试运行保护：每次启动前计数，新版本连续起不来时自动切回上一个版本。
# "-" 前缀：脚本失败也不阻止启动（脚本本身也总是以 0 退出）。
# 它在 ExecStart 之前执行，切换 current 后 ExecStart 才解析这个软链接。
ExecStartPre=-/opt/vendor/scripts/upgrade-guard.sh

# 通过符号链接启动程序
ExecStart=/opt/vendor/current/antenna_mgmt /opt/vendor/config/antenna_mgmt.conf

# 重启策略
Restart=always
RestartSec=10
StartLimitInterval=0
StartLimitBurst=0

# 资源限制
LimitNOFILE=65536
LimitNPROC=4096

# 日志配置
StandardOutput=journal
StandardError=journal
SyslogIdentifier=antenna-mgmt

# 安全加固
NoNewPrivileges=false
PrivateTmp=true

# 环境变量
Environment="LD_LIBRARY_PATH=/opt/vendor/current/lib"

[Install]
WantedBy=multi-user.target
